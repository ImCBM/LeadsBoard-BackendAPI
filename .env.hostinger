APP_NAME=LeadsBoard-API
APP_ENV=production
APP_KEY=base64:vremMFjiG7/8gstIwHHueQwCGb8vhBTwCZl5D4ZK4Uc=
APP_DEBUG=false
APP_URL=https://backend.b2bleadscraper.certicode.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Hostinger MySQL Database Settings ───────────────────
# Update DB_DATABASE, DB_USERNAME, and DB_PASSWORD with your credentials from Hostinger hPanel -> Databases -> Management
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u850020960_b2bleadscraper
DB_USERNAME=u850020960_b2buser
DB_PASSWORD=YOUR_HOSTINGER_DB_PASSWORD

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@certicode.net"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Webhook & Security ──────────────────────────────────
# Use this secret token in n8n (Header: Authorization: Bearer <WEBHOOK_SECRET> or X-Webhook-Token: <WEBHOOK_SECRET>)
WEBHOOK_SECRET=b2bleadscraper-prod-webhook-token-7f9a2e8c4d1b

# ─── Leads Configuration ────────────────────────────────
LEADS_PER_PAGE=25

# ─── API Rate Limiting ──────────────────────────────────
API_DEFAULT_RATE_LIMIT=120

# ─── CORS Allowed Origins ────────────────────────────────
# Allowed frontend origins:
CORS_ALLOWED_ORIGINS=https://b2bleadscraper.certicode.net,https://certicode.net,http://localhost:5173
